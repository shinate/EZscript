[script]
//==========================
// F.H.D - 光芒
// 圣斗士(高防)
// 2018-11-20
//==========================

//==== 键位设置 >>> ====
// 选择目标（NPC）
ExtVar[0]=69
// Q:81选择自己
ExtVar[1]=81
// 开/关姿势
ExtVar[2]=88
// 选用姿势
ExtVar[3]=118
// 武神力量
ExtVar[4]=114
// 力量祷告
ExtVar[5]=115
// 单加
ExtVar[6]=113
// 吸魔
ExtVar[7]=49
// 减抗
ExtVar[8]=50
// 小爆
ExtVar[9]=51
// 追踪
ExtVar[10]=84
//==== <<< 键位设置 ====

//==== 时间设置 >>> ====
// 姿势 & buff持续时间(秒)
ExtVar[13]=1700
// 武神力量持续时间
ExtVar[15]=840
// 单加CD
ExtVar[26]=2500
//==== <<< 时间设置 ====

//==== 其他设置 >>> ====
// 随机目标，随机1~N个目标，0为关闭(只选择自己)
ExtVar[30]=5
//==== <<< 其他设置 ====

//==========================
// 初始化
// 姿势计时器
ExtVar[23]=0
// 武神力量计时器
ExtVar[25]=0

ExtVar[30]=ExtVar[30]-1

//==== 主进程 >>> ====
Main:
Call BuffPosture
Call BuffSkill
Call Attack
Jump Main
Return
//==== <<< 主进程 ====

//武神力量
BuffSkill:
if ExtVar[15]>0 && Time-ExtVar[25]>ExtVar[15] then
SendKey(ExtVar[4])
Delay(4000)
ExtVar[25]=Time
end if
Return

//姿势
BuffPosture:
if ExtVar[13]>0 && Time-ExtVar[23]>ExtVar[13] then
SendKey(ExtVar[4])
Delay(5000)
SendKey(ExtVar[2])
Delay(1000)
SendKey(ExtVar[3])
Delay(3000)
SendKey(ExtVar[2])
Delay(1000)
ExtVar[23]=Time
end if
Return

//选择自己
TargetSelf:
SendKey(ExtVar[1])
Delay(50)
Return

//随机目标
RandomTarget:
if ExtVar[30]>-1 then
Repeat Rand[ExtVar[30]]+1
SendKey(ExtVar[0])
Delay(50)
End Repeat
end if
Return

//就近目标
NearlyTarget:
SendKey(ExtVar[1])
Delay(50)
SendKey(ExtVar[0])
Delay(50)
Return

// 单加
HealSingle:
if ExtVar[6]>0 then
Call TargetSelf
SendKey(ExtVar[6])
Delay(ExtVar[26])
end if
Return

//攻击
Attack:
SendKey(ExtVar[10])
Delay(50)
// 随机拉怪，闪电
Call RandomTarget
SendKey(ExtVar[7])
Delay(50)
Call TargetSelf
SendKey(ExtVar[7])
Delay(3000)
// 打
Repeat 2
SendKey(ExtVar[8])
Delay(3000)
SendKey(ExtVar[9])
Delay(6000)
Call HealSingle
Call HealSingle
End Repeat
Return