[script]
//==========================
// F.H.D - 光芒
// 斥候追踪反隐伪装
// 2026-07-17
//==========================

//==== 键位设置 >>> ====
// 追踪
ExtVar[0]=84
// 反隐
ExtVar[1]=50
// 伪装
ExtVar[2]=51
//==== <<< 键位设置 ====

//==== 时间设置 >>> ====
// 追踪间隔（毫秒）
ExtVar[10]=8000
// 反隐间隔（秒）
ExtVar[11]=50
// 伪装间隔（秒）
ExtVar[12]=300
//==== <<< 时间设置 ====

//==== 其他设置 >>> ====
//==== <<< 其他设置 ====

//==========================
//初始化
ExtVar[21]=0
ExtVar[22]=0

//==== 主进程 >>> ====
Main:
Call Fan
Call Wei
Call Attack
Jump Main
Return
//==== <<< 主进程 ====

//反隐
Fan:
if ExtVar[11]>0 && Time-ExtVar[21]>ExtVar[11] then
SendKey(ExtVar[1])
Delay(5000)
ExtVar[21]=Time
end if
Return

//伪装
Wei:
if ExtVar[12]>0 && Time-ExtVar[22]>ExtVar[12] then
SendKey(ExtVar[2])
Delay(10000)
ExtVar[22]=Time
end if
Return

//默认循环流程
Attack:
SendKey(ExtVar[0])
Delay(ExtVar[10])
Return