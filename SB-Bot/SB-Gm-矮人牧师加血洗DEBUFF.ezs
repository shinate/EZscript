[variable]
var1=
var2=
var3=
var4=
var5=
var6=
var7=
var8=
pos1=
pos2=
pos3=
pos4=
pos5=
pos6=
pos7=
pos8=
[script]
//==========================
// F.H.D - 光芒
// 牧师
// 2026-08-04
//==========================

//==== 键位设置 >>> ====
// E:选择目标（NPC）
ExtVar[0]=69
// Q:81选择自己
ExtVar[1]=81
// X:开/关姿势
ExtVar[2]=88
// F5:选用姿势
ExtVar[3]=116
// F2:单持续
ExtVar[4]=113
// F3:群持续
ExtVar[5]=114
// F4:单洗
ExtVar[6]=115
// 4:15秒单晕 45秒免疫
ExtVar[7]=52
// 选择队友（小键盘） 0~9 96-105 累加并循环
ExtVar[9]=96
//==== <<< 键位设置 ====

//==== 时间设置 >>> ====
//姿势 & buff持续时间(秒)
ExtVar[13]=1700
//持续加血时间(秒)
ExtVar[14]=25
//单洗持续时间
ExtVar[16]=10
//单晕持续时间
ExtVar[17]=30
//==== <<< 时间设置 ====

//==== 其他设置 >>> ====
// 队友数量
ExtVar[19]=10
//==== <<< 其他设置 ====

//==========================
//初始化
//姿势buff计时器
ExtVar[23]=0
//持续加血计时器
ExtVar[24]=0
//单洗计时器
ExtVar[26]=0
//单晕计时器
ExtVar[27]=0
ExtVar[29]=ExtVar[9]+ExtVar[19]

//==== 主进程 >>> ====
Main:
Call BuffPosture
Call MianYun
Call ClearCurse
Call Attack
Delay(1000)
Jump Main
Return
//==== <<< 主进程 ====

//姿势
BuffPosture:
if ExtVar[13]>0 && Time-ExtVar[23]>ExtVar[13] then
SendKey(ExtVar[2])
Delay(2000)
SendKey(ExtVar[3])
Delay(2000)
SendKey(ExtVar[2])
Delay(2000)
ExtVar[23]=Time
end if
Return

//洗诅咒
ClearCurse:
if ExtVar[16]>0 && Time-ExtVar[26]>ExtVar[16] then
SendKey(ExtVar[9])
Delay(50)
Repeat 2:
SendKey(ExtVar[6])
Delay(2000)
End Repeat
ExtVar[9]=ExtVar[9]+1
if ExtVar[9]>ExtVar[29]-1 then
ExtVar[9]=96
end if
ExtVar[26]=Time
end if
Return

MianYun:
if ExtVar[17]>0 && Time-ExtVar[27]>ExtVar[17] then
Call TargetSelf
SendKey(ExtVar[7])
Delay(1000)
ExtVar[27]=Time
end if
Return

//选择自己
TargetSelf:
SendKey(ExtVar[1])
Delay(50)
Return

//默认循环流程
Attack:
if ExtVar[14]>0 && Time-ExtVar[24]>ExtVar[14] then
Call TargetSelf
SendKey(ExtVar[4])
Delay(3000)
SendKey(ExtVar[5])
Delay(5000)
ExtVar[24]=Time
end if
Return